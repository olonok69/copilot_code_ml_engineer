{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "type": "command",
        "matcher": "bash|powershell",
        "bash": "./.github/hooks/block-external-git.sh",
        "powershell": "./.github/hooks/block-external-git.ps1",
        "cwd": ".",
        "timeoutSec": 10
      }
    ]
  }
}
